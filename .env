# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Governance Layer
APP_VERSION=1.0.0
DEBUG=true

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://govuser:govpass@localhost:5432/govdb
DATABASE_URL_ASYNC=postgresql+asyncpg://govuser:govpass@localhost:5432/govdb

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Audit ────────────────────────────────────────────────────────────────────
AUDIT_HASH_ALGORITHM=sha256

# ─── OPA (Person 1 integration) ───────────────────────────────────────────────
OPA_URL=http://localhost:8181
OPA_POLICY_PATH=/v1/data/governance/allow

# ─── Kill Switch Redis Keys ────────────────────────────────────────────────────
REDIS_FLEET_HALT_KEY=fleet:halted
REDIS_AGENT_HALT_PREFIX=agent:halted:

# ─── Budget defaults (INR) ────────────────────────────────────────────────────
TRAVEL_AGENT_DAILY_LIMIT=15000
SERVICING_AGENT_DAILY_LIMIT=20000
REWARDS_AGENT_DAILY_LIMIT=10000
